# Copy to .env and fill in real values. .env is gitignored.
# BGM-789 spike — BGA per-game stats recon

BGA_EMAIL=you@example.com
BGA_PASSWORD=your-bga-password

# Optional: BGA player ID to inspect. Defaults to the ticket example (84147370).
# BGA_PLAYER_ID=84147370

# Optional: comma-separated BGA game IDs to inspect. If unset, the script picks
# Formula D (1845) plus 3 of the player's most-played games discovered from
# /gamestats. Example: BGA_GAME_IDS=1845,1,12,156
# BGA_GAME_IDS=

# Optional: set to 1 to force headful mode for debugging (default: headless
# after first login).
# HEADFUL=0
