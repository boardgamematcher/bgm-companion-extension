{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.7.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "BoardGameMatcher",
  "homepage_url": "https://boardgamematcher.com",
  "permissions": ["activeTab", "alarms", "contextMenus", "notifications", "storage", "scripting"],
  "host_permissions": [
    "https://boardgamematcher.com/*",
    "https://boardgamearena.com/*",
    "https://en.boardgamearena.com/*",
    "https://tabletopia.com/*",
    "https://ludopedia.com.br/*",
    "https://www.ludopedia.com.br/*",
    "https://www.philibertnet.com/*",
    "https://philibertnet.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bgm-toolbox@boardgamematcher.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.at/*",
        "*://*.amazon.be/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.com/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.de/*",
        "*://*.amazon.es/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.nl/*",
        "*://*.amazon.pl/*",
        "*://*.amazon.se/*",
        "*://*.board-game.co.uk/*",
        "*://*.boardgamebliss.com/*",
        "*://*.bol.com/*",
        "*://*.brettspielversand.de/*",
        "*://*.coolshop.co/*",
        "*://*.coolshop.com/*",
        "*://*.coolshop.de/*",
        "*://*.coolshop.dk/*",
        "*://*.coolshop.fi/*",
        "*://*.coolshop.is/*",
        "*://*.coolshop.nl/*",
        "*://*.coolshop.no/*",
        "*://*.coolshop.pl/*",
        "*://*.coolshop.se/*",
        "*://*.coolstuffinc.com/*",
        "*://*.cultura.com/*",
        "*://*.espritjeu.com/*",
        "*://*.fantasywelt.de/*",
        "*://*.fnac.com/*",
        "*://*.gamenerdz.com/*",
        "*://*.gamersdream.shop/*",
        "*://*.knapix.com/*",
        "*://*.kutami.de/*",
        "*://*.le-passe-temps.com/*",
        "*://*.lepion.com/*",
        "*://*.ludifolie.com/*",
        "*://*.ludiprix.fr/*",
        "*://ludiprix.fr/*",
        "*://*.ludisphere.fr/*",
        "*://*.ludum.fr/*",
        "*://*.milan-spiele.de/*",
        "*://*.miniaturemarket.com/*",
        "*://*.okkazeo.com/*",
        "*://*.philibertnet.com/*",
        "*://*.privalia.com/*",
        "*://*.spiele-offensive.de/*",
        "*://*.spieletaxi.de/*",
        "*://*.thalia.de/*",
        "*://*.veepee.at/*",
        "*://*.veepee.be/*",
        "*://*.veepee.de/*",
        "*://*.veepee.es/*",
        "*://*.veepee.fr/*",
        "*://*.veepee.it/*",
        "*://*.veepee.lu/*",
        "*://*.veepee.nl/*"
      ],
      "js": ["src/lib/pattern-matcher.js", "src/content/content-script.js"]
    },
    {
      "matches": [
        "*://*.amazon.at/*",
        "*://*.amazon.be/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.com/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.de/*",
        "*://*.amazon.es/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.nl/*",
        "*://*.amazon.pl/*",
        "*://*.amazon.se/*",
        "*://*.board-game.co.uk/*",
        "*://*.boardgamebliss.com/*",
        "*://*.bol.com/*",
        "*://*.brettspielversand.de/*",
        "*://*.coolshop.co/*",
        "*://*.coolshop.com/*",
        "*://*.coolshop.de/*",
        "*://*.coolshop.dk/*",
        "*://*.coolshop.fi/*",
        "*://*.coolshop.is/*",
        "*://*.coolshop.nl/*",
        "*://*.coolshop.no/*",
        "*://*.coolshop.pl/*",
        "*://*.coolshop.se/*",
        "*://*.coolstuffinc.com/*",
        "*://*.cultura.com/*",
        "*://*.espritjeu.com/*",
        "*://*.fantasywelt.de/*",
        "*://*.fnac.com/*",
        "*://*.gamenerdz.com/*",
        "*://*.gamersdream.shop/*",
        "*://*.knapix.com/*",
        "*://*.kutami.de/*",
        "*://*.le-passe-temps.com/*",
        "*://*.lepion.com/*",
        "*://*.ludifolie.com/*",
        "*://*.ludiprix.fr/*",
        "*://ludiprix.fr/*",
        "*://*.ludisphere.fr/*",
        "*://*.ludum.fr/*",
        "*://*.milan-spiele.de/*",
        "*://*.miniaturemarket.com/*",
        "*://*.okkazeo.com/*",
        "*://*.philibertnet.com/*",
        "*://*.privalia.com/*",
        "*://*.spiele-offensive.de/*",
        "*://*.spieletaxi.de/*",
        "*://*.thalia.de/*",
        "*://*.veepee.at/*",
        "*://*.veepee.be/*",
        "*://*.veepee.de/*",
        "*://*.veepee.es/*",
        "*://*.veepee.fr/*",
        "*://*.veepee.it/*",
        "*://*.veepee.lu/*",
        "*://*.veepee.nl/*"
      ],
      "js": ["src/lib/normalize.js", "src/content/wishlist-badge.js"],
      "css": ["src/content/wishlist-badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.yucata.de/*"],
      "js": [
        "src/lib/yucata-mapper.js",
        "src/content/yucata-scraper.js",
        "src/content/yucata-listener.js"
      ]
    },
    {
      "matches": ["https://boardgamearena.com/*", "https://en.boardgamearena.com/*"],
      "js": ["src/content/bga-scraper.js", "src/content/bga-listener.js"]
    },
    {
      "matches": ["https://boardgamegeek.com/*", "https://www.boardgamegeek.com/*"],
      "js": ["src/content/bgg-scraper.js", "src/content/bgg-listener.js"]
    },
    {
      "matches": ["https://tabletopia.com/*"],
      "js": ["src/content/tabletopia-scraper.js", "src/content/tabletopia-listener.js"]
    },
    {
      "matches": ["https://ludopedia.com.br/*", "https://www.ludopedia.com.br/*"],
      "js": ["src/content/ludopedia-scraper.js", "src/content/ludopedia-listener.js"]
    },
    {
      "matches": ["*://*.philibertnet.com/*"],
      "js": ["src/content/game-overlay.js"],
      "css": ["src/content/game-overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["patterns/built-in.json"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["patterns/yucata-mapping.json", "src/content/yucata-page-extract.js"],
      "matches": ["https://www.yucata.de/*"]
    },
    {
      "resources": ["patterns/bga-mapping.json"],
      "matches": ["https://boardgamearena.com/*", "https://en.boardgamearena.com/*"]
    },
    {
      "resources": ["patterns/tabletopia-mapping.json"],
      "matches": ["https://tabletopia.com/*"]
    }
  ]
}
