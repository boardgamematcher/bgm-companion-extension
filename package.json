{
  "name": "bgm-toolbox",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "BGM Toolbox — BoardGameMatcher browser extension",
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{js,css,html,json}'",
    "format:check": "prettier --check 'src/**/*.{js,css,html,json}'",
    "manifest:update": "node scripts/update-manifest-matches.js",
    "docs:sites": "node scripts/gen-supported-sites.mjs",
    "docs:sites:check": "node scripts/gen-supported-sites.mjs --check",
    "sync-profiles": "cp ../site-profiles/profiles.json patterns/built-in.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:capture": "node tests-e2e/scripts/capture-fixtures.mjs",
    "test:browser": "node scripts/open-test-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "^3.0.0"
  }
}
